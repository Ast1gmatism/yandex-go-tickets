<?xml version="1.0" encoding="utf-8"?>
<!-- Экран открытого билета: точно как в референсе — без прокрутки,
     статичная картинка + идущие цифры таймера -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/screen_bg">

    <View
        android:id="@+id/gradientView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/gradient_height"
        android:background="@drawable/bg_screen_gradient" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <include
            android:id="@+id/detailToolbar"
            layout="@layout/view_toolbar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <include
            android:id="@+id/ticketCard"
            layout="@layout/item_ticket"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/screen_padding"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="@dimen/screen_padding" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="@dimen/details_padding"
            android:paddingEnd="@dimen/details_padding"
            android:paddingBottom="8dp">

            <TextView
                android:id="@+id/detailsTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/details_title_margin_top"
                android:fontFamily="@font/ys_text_bold"
                android:text="@string/details_title"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/details_title_size" />

            <include
                android:id="@+id/rowRegistration"
                layout="@layout/row_detail"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/rowBoard"
                layout="@layout/row_detail"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/rowCarrier"
                layout="@layout/row_detail"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/rowValidUntil"
                layout="@layout/row_detail"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <include
                android:id="@+id/rowDirection"
                layout="@layout/row_detail"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <View
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="0.3" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
