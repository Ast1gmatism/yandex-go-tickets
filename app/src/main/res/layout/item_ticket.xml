<?xml version="1.0" encoding="utf-8"?>
<!-- Карточка билета: синяя шапка -> зубчатый разделитель -> серое тело -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/ticketCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/screen_bg"
    app:cardCornerRadius="@dimen/card_corner"
    app:cardElevation="0dp"
    app:rippleColor="@color/ripple"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:id="@+id/passHeader"
            android:layout_width="match_parent"
            android:layout_height="@dimen/card_header_height"
            android:background="@drawable/bg_bill_header">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="10dp"
                android:paddingEnd="20dp">

                <TextView
                    android:id="@+id/passTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/ys_text_bold"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/bill_title_size"
                    tools:text="Троллейбус 8" />

                <TextView
                    android:id="@+id/passDirection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="5dp"
                    android:fontFamily="@font/ys_text_regular"
                    android:gravity="center"
                    android:textColor="#FFFFFF"
                    android:textSize="@dimen/bill_direction_size"
                    tools:text="площадь Свободы → Деревня Универсиады-7" />
            </LinearLayout>
            <ImageButton
                android:id="@+id/ticketDelete"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_gravity="top|end"
                android:layout_marginTop="4dp"
                android:layout_marginEnd="4dp"
                android:alpha="0.9"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/delete_ticket"
                android:padding="10dp"
                android:src="@drawable/ic_ticket_delete" />
        </FrameLayout>

        <com.trolleygo.tickets.ui.widget.PassDividerView
            android:id="@+id/passDivider"
            android:layout_width="match_parent"
            android:layout_height="@dimen/divider_height" />

        <LinearLayout
            android:id="@+id/ticketBody"
            android:layout_width="match_parent"
            android:layout_height="@dimen/bill_body_height"
            android:background="@drawable/bg_bill_body"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingTop="@dimen/timer_padding_top"
            android:paddingEnd="12dp">

            <TextView
                android:id="@+id/timerLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_text_bold"
                android:gravity="center"
                android:text="@string/ticket_valid"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/timer_label_size" />

            <com.trolleygo.tickets.ui.widget.TimerDigitsView
                android:id="@+id/timerView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/timer_margin_top" />

            <TextView
                android:id="@+id/controllerNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/timer_note_margin_top"
                android:fontFamily="@font/ys_text_regular"
                android:gravity="center"
                android:text="@string/ticket_show_to_controller"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/timer_note_size" />
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
