<?xml version="1.0" encoding="utf-8"?>
<!-- Строка блока «Детали». Высоту задаёт родитель (вес), внутренняя
     анатомия по референсу: лейбл 0-11.5dp, значение +16dp,
     разделитель +42dp, центр иконки +14dp. Шаг строк — 56dp. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/detailIcon"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_marginTop="1dp"
            android:layout_marginEnd="15dp"
            android:contentDescription="@string/content_desc_icon"
            android:scaleType="fitCenter" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/detailLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/ys_text_regular"
                android:includeFontPadding="false"
                android:textColor="@color/text_secondary"
                android:textSize="@dimen/detail_label_size"
                tools:text="Регистрационный номер" />

            <TextView
                android:id="@+id/detailValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="@font/ys_text_regular"
                android:includeFontPadding="false"
                android:textColor="@color/text_primary"
                android:textSize="@dimen/detail_value_size"
                tools:text="ТР2021" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/detailDivider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginStart="39dp"
        android:layout_marginTop="8dp"
        android:background="@color/divider" />
</LinearLayout>
