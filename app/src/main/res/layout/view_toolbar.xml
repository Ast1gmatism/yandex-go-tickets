<?xml version="1.0" encoding="utf-8"?>
<!-- Верхняя панель: Назад | «Мои билеты» + подпись | Обновить.
     Геометрия по референсу (от низа статус-бара): центр кнопок +26dp,
     заголовок 11.9-23.4dp, подпись 31.3-42dp. Заголовок — регуляр. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="50dp">

    <ImageButton
        android:id="@+id/toolbarBack"
        style="@style/Widget.Go.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="start|top"
        android:layout_marginStart="4dp"
        android:layout_marginTop="3dp"
        android:contentDescription="@string/back"
        android:src="@drawable/ic_arrow_back" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginTop="10dp"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingStart="76dp"
        android:paddingEnd="76dp">

        <TextView
            android:id="@+id/toolbarTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="@font/ys_text_regular"
            android:includeFontPadding="false"
            android:textColor="@color/text_primary"
            android:textSize="16sp"
            tools:text="Мои билеты" />

        <TextView
            android:id="@+id/toolbarSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:fontFamily="@font/ys_text_regular"
            android:includeFontPadding="false"
            android:text="@string/screen_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/toolbarAction"
        style="@style/Widget.Go.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="end|top"
        android:layout_marginEnd="4dp"
        android:layout_marginTop="3dp"
        android:contentDescription="@string/refresh"
        android:src="@drawable/ic_refresh" />
</FrameLayout>
