<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <style name="Theme.TrolleyTickets" parent="Theme.MaterialComponents.Light.NoActionBar">
        <!-- Запрещаем системному тёмному режиму ломать цвета (текст в полях становился невидимым) -->
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:editTextColor">@color/text_primary</item>
        <item name="colorPrimary">@color/bill_header</item>
        <item name="colorPrimaryDark">@color/bill_header</item>
        <item name="colorAccent">@color/bill_header</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="android:windowBackground">@color/screen_bg</item>
        <!-- Прозрачный статус-бар: градиент начинается от верха экрана, под иконками времени/сети -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="android:navigationBarColor">@color/screen_bg</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">true</item>
        <item name="android:textColorPrimary">@color/text_primary</item>
        <item name="android:textColorSecondary">@color/text_secondary</item>
        <item name="android:fontFamily">@font/ys_text_regular</item>
        <item name="fontFamily">@font/ys_text_regular</item>
        <item name="materialButtonStyle">@style/Widget.Go.Button</item>
        <item name="bottomSheetDialogTheme">@style/Theme.TrolleyTickets.BottomSheet</item>
    </style>

    <style name="Theme.TrolleyTickets.BottomSheet" parent="Theme.MaterialComponents.BottomSheetDialog">
        <item name="android:forceDarkAllowed" tools:targetApi="q">false</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowDrawsSystemBarBackgrounds">true</item>
        <item name="bottomSheetStyle">@style/Widget.Go.BottomSheet</item>
        <item name="android:fontFamily">@font/ys_text_regular</item>
        <item name="colorControlActivated">@color/bill_header</item>
    </style>

    <style name="Widget.Go.BottomSheet" parent="Widget.MaterialComponents.BottomSheet.Modal">
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.Go.BottomSheet</item>
        <item name="behavior_peekHeight">720dp</item>
        <item name="android:background">@color/screen_bg</item>
    </style>

    <style name="ShapeAppearance.Go.BottomSheet" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">22dp</item>
        <item name="cornerSizeTopRight">22dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="Widget.Go.Button" parent="Widget.MaterialComponents.Button">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_text_medium</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/bill_header</item>
    </style>

    <style name="Widget.Go.Button.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="cornerRadius">16dp</item>
        <item name="android:minHeight">54dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:fontFamily">@font/ys_text_medium</item>
        <item name="strokeColor">@color/bill_header</item>
        <item name="android:textColor">@color/bill_header</item>
    </style>

    <style name="Widget.Go.IconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">?android:attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">12dp</item>
        <item name="tint">@color/text_primary</item>
    </style>

    <style name="Widget.Go.TextField" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxCornerRadiusTopStart">14dp</item>
        <item name="boxCornerRadiusTopEnd">14dp</item>
        <item name="boxCornerRadiusBottomStart">14dp</item>
        <item name="boxCornerRadiusBottomEnd">14dp</item>
        <item name="boxStrokeColor">@color/bill_header</item>
        <item name="hintTextColor">@color/text_secondary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="errorTextAppearance">@style/TextAppearance.Go.Error</item>
    </style>

    <style name="TextAppearance.Go.Error" parent="TextAppearance.MaterialComponents.Caption">
        <item name="android:textColor">@color/danger</item>
    </style>
</resources>
